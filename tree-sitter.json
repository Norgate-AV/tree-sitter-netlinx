{
    "grammars": [
        {
            "name": "netlinx",
            "camelcase": "NetLinx",
            "scope": "source.netlinx",
            "path": ".",
            "file-types": ["axs", "axi", "axb", "lib"],
            "highlights": ["queries/highlights.scm"],
            "tags": "queries/tags.scm",
            "locals": "queries/locals.scm",
            "folds": "queries/folds.scm",
            "first-line-regex": "(?i)^(program|module)_name\\s*=.*$",
            "content-regex": "(?i)^define_(device|constant|type|variable|start|event|program)$",
            "injection-regex": "^netlinx$"
        }
    ],
    "metadata": {
        "version": "1.0.4",
        "license": "MIT",
        "description": "NetLinx grammar for tree-sitter",
        "links": {
            "repository": "https://github.com/Norgate-AV/tree-sitter-netlinx"
        }
    },
    "bindings": {
        "c": true,
        "go": true,
        "node": true,
        "python": true,
        "rust": true,
        "swift": true,
        "zig": true
    }
}
